{
  "name": "openai-translator",
  "version": "1.3.0",
  "description": "OpenAI wire-format translator for the intisy-ai AI-proxy ecosystem.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/openai-translator.git"
  },
  "keywords": [
    "ir",
    "canonical-ir",
    "openai",
    "ai",
    "intisy",
    "openai-translator"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:teavm": "node node_modules/@intisy/bayonet/scripts/teavm-build.mjs --java-dir . --module :teavm-openai --out src/generated/openai-translator.teavm.js",
    "build": "npm run emit:teavm && npm run build:teavm && tsc && node build.mjs",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build",
    "emit:teavm": "node node_modules/@intisy/bayonet/scripts/emit-dts.mjs --java-dir . --module :teavm-openai --out src/generated",
    "docs": "typedoc"
  },
  "dependencies": {
    "@intisy/bayonet": "^1.8.0",
    "@intisy-ai/basekit": "^5.0.0"
  },
  "devDependencies": {
    "@intisy/bayonet": "^1.8.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
